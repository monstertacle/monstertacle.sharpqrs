<Project>
  <PropertyGroup><ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally></PropertyGroup>
  <ItemGroup>
    <PackageVersion Condition="'$(TargetFramework)' != 'net11.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    <PackageVersion Condition="'$(TargetFramework)' != 'net11.0'" Include="Microsoft.Extensions.DependencyInjection" Version="10.0.14" />
    <PackageVersion Condition="'$(TargetFramework)' != 'net11.0'" Include="Microsoft.AspNetCore.TestHost" Version="10.0.14" />
    <PackageVersion Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="11.0.0" />
    <PackageVersion Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Condition="'$(TargetFramework)' == 'net11.0'" Include="Microsoft.AspNetCore.TestHost" Version="11.0.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
  </ItemGroup>
</Project>
